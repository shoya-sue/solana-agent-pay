# Copy to .env and fill in. Never commit .env.

# Anthropic API key used by the agent (Claude tool use)
ANTHROPIC_API_KEY=

# Claude model (default: claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Solana devnet RPC (devnet only — mainnet URLs are refused)
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent spending policy, in dUSDC (test token, 6 decimals)
# AGENT_PER_CALL_CAP=0.10
# AGENT_TOTAL_BUDGET=0.30

# Comma-separated recipient allowlist (defaults to the demo server's wallet from .wallets/state.json)
# ALLOWED_RECIPIENTS=

# Paid API server port / URL for `npm run agent`
# PORT=4021
# SERVER_URL=http://localhost:4021
