{
  "name": "solana-agent-pay",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent (Claude) that pays for API calls by itself with SPL tokens on Solana devnet, using an x402-style HTTP 402 flow.",
  "type": "module",
  "license": "MIT",
  "author": "shoya-sue",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/scripts/setup.ts",
    "server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/server/index.ts",
    "agent": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/agent/index.ts",
    "demo": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/scripts/demo.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:devnet": "NODE_OPTIONS=--disable-warning=ExperimentalWarning DEVNET_TESTS=1 vitest run test/devnet.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:local": "NODE_OPTIONS=--disable-warning=ExperimentalWarning FACILITATOR=local SOLANA_RPC_URL=http://127.0.0.1:8899 WALLET_DIR=.wallets-local DATA_DIR=data/local DEMO_OUTPUT=data/local/demo-output-local.txt tsx src/scripts/demo.ts",
    "facilitator": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/facilitator/index.ts",
    "demo:local-facilitator": "FACILITATOR=local npm run demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
